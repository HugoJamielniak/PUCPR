$dbName = 'web';
$conexao = new mysqli($dbHost, $dbUsername, $dbSenha, $dbName);

$erro1 = '';
$erroEmail = '';

if (isset($_POST['submit'])) {
    $nome = trim($_POST['nome']);
    $endereco = trim($_POST['endereco']);
    $email = trim($_POST['email']);
    $senha = trim($_POST['senha']);
    $telefone = trim($_POST['telefone']);

    // Verifica se algum campo está vazio
    if (empty($nome) || empty($endereco) || empty($email) || empty($senha) || empty($telefone)) {
        $erro1 = "Por favor, preencha todos os campos!";
    } else {
        // --- Validação simples de e-mail ---
        if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
            $erroEmail = "Formato de e-mail inválido!";
        } else {
            $dominio = substr(strrchr($email, "@"), 1);
            if (!checkdnsrr($dominio, "MX")) {
                $erroEmail = "Domínio de e-mail inválido ou inexistente!";
            }
        }

        // Se não houver erros, insere no banco
        if (empty($erroEmail)) {
            $stmt = $conexao->prepare("INSERT INTO cliente (nome, endereco, email, senha, telefone) VALUES (?, ?, ?, ?, ?)");
            $stmt->bind_param("sssss", $nome, $endereco, $email, $senha, $telefone);

            if ($stmt->execute()) {
                header("Location: login.php");
                exit();
            } else {
                $erro1 = "Erro ao cadastrar no banco!";
            }
        }
    }
}
