<script>
// --- Mostrar/Ocultar senha ---
function mostrarSenha() {
    const campo = document.getElementById("senha");
    campo.type = campo.type === "password" ? "text" : "password";
}

// --- Verificar força da senha ---
function verificarForcaSenha() {
    const senha = document.getElementById("senha").value;
    const mensagem = document.getElementById("mensagem-forca");

    let forca = 0;

    if (senha.length >= 8) forca++; // tamanho mínimo
    if (/[A-Z]/.test(senha)) forca++; // letra maiúscula
    if (/[a-z]/.test(senha)) forca++; // letra minúscula
    if (/[0-9]/.test(senha)) forca++; // número
    if (/[^A-Za-z0-9]/.test(senha)) forca++; // símbolo

    if (senha.length === 0) {
        mensagem.textContent = "";
        mensagem.className = "forca-senha";
        return;
    }

    switch(forca) {
        case 1:
        case 2:
            mensagem.textContent = "Senha fraca 🔴";
            mensagem.className = "forca-senha fraca";
            break;
        case 3:
        case 4:
            mensagem.textContent = "Senha média 🟠";
            mensagem.className = "forca-senha media";
            break;
        case 5:
            mensagem.textContent = "Senha forte 🟢";
            mensagem.className = "forca-senha forte";
            break;
    }
}
</script>
